---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArticleSchema from '../components/ArticleSchema.astro';
import FormattedDate from '../components/FormattedDate.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { title, description, pubDate, updatedDate, heroImage, id } = Astro.props;
const url = `/blog/${id}/`;
---

<Base title={title} description={description} path={url}>
	<ArticleSchema
		title={title}
		description={description}
		url={url}
		pubDate={pubDate}
		updatedDate={updatedDate}
	/>
	<article>
		{heroImage && (
			<div class="hero-img">
				<Image src={heroImage} alt={title} width={1200} height={480} />
			</div>
		)}
		<div class="prose wrap">
			<p class="eyebrow">
				<FormattedDate date={pubDate} />
				{updatedDate && <span> · Updated <FormattedDate date={updatedDate} /></span>}
			</p>
			<h1>{title}</h1>
			<slot />
			<p class="risks-link" style="font-size:0.85rem; color:var(--ink-soft); margin-top:2rem; border-top:1px solid var(--rule,#e5e0d5); padding-top:1rem;">
				Educational content only — not financial advice. Only trade with money you can afford to lose.
				<a href="/risks-and-responsible-trading">Risks and responsible trading →</a>
			</p>
			<RelatedGuides slug={id} />
		</div>
	</article>
</Base>

<style>
	.hero-img {
		width: 100%;
		max-height: 420px;
		overflow: hidden;
		margin-bottom: 0;
	}

	.hero-img img {
		width: 100%;
		height: 420px;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}

	@media (max-width: 640px) {
		.hero-img img {
			height: 220px;
		}
	}
</style>
