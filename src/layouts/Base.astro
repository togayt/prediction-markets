---
import { SITE_NAME, SITE_URL, SITE_TAGLINE } from "../config";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** path like "/compare" — used for canonical URL */
  path?: string;
  /** optional extra JSON-LD object (FAQ, Article, etc.) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path = "/", schema } = Astro.props;
const fullTitle = path === "/" ? `${SITE_NAME} — ${SITE_TAGLINE}` : `${title} · ${SITE_NAME}`;
const canonical = new URL(path, SITE_URL).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_TAGLINE,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data for Google + AI answers -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>

  <body>
    <div class="disclosure-bar">
      We earn commissions from some links. <a href="/how-we-make-money">How we make money →</a>
    </div>

    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/"><span class="dot"></span>{SITE_NAME}</a>
        <nav class="nav">
          <a href="/what-is-a-prediction-market">Basics</a>
          <a href="/compare">Compare</a>
          <a href="/guides/how-to-use-kalshi">Guides</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div>
          <strong>{SITE_NAME}</strong> · {SITE_TAGLINE}<br />
          <span style="font-size:0.82rem">Educational content only — not financial advice. 18+ where applicable. Trade responsibly.</span>
        </div>
        <nav>
          <a href="/about">About</a>
          <a href="/how-we-make-money">How we make money</a>
          <a href="/compare">Compare</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
