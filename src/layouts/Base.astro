---
import { SITE_NAME, SITE_URL, SITE_TAGLINE } from "../config";
import "../styles/global.css";
import NewsletterCapture from "../components/NewsletterCapture.astro";

interface Props {
  title: string;
  description: string;
  /** path like "/compare": used for canonical URL */
  path?: string;
  /** optional extra JSON-LD object (FAQ, Article, etc.) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** absolute or root-relative URL for og:image — defaults to /og-default.svg */
  ogImage?: string;
}

const { title, description, path = "/", schema, ogImage = "/og-default.svg" } = Astro.props;
const fullTitle = path === "/" ? `${SITE_NAME}: ${SITE_TAGLINE}` : `${title} · ${SITE_NAME}`;
const canonical = new URL(path, SITE_URL).href;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : new URL(ogImage, SITE_URL).href;

// Webmaster verification — set these in .env (see .env.example)
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_TAGLINE,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Webmaster verification (set PUBLIC_GSC_VERIFICATION / PUBLIC_BING_VERIFICATION in .env) -->
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data for Google + AI answers -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QRWMH5Y23P"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QRWMH5Y23P');
    </script>
  </head>

  <body>
    <div class="disclosure-bar">
      We earn commissions from some links. <a href="/how-we-make-money">How we make money →</a>
    </div>

    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/"><span class="dot"></span>{SITE_NAME}</a>
        <nav class="nav">
          <a href="/what-is-a-prediction-market">Basics</a>
          <a href="/compare">Compare</a>
          <a href="/guides/how-to-use-kalshi">Guides</a>
          <a href="/blog">Articles</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <NewsletterCapture />

    <footer class="site-foot">
      <div class="wrap">
        <div>
          <strong>{SITE_NAME}</strong> · {SITE_TAGLINE}<br />
          <span style="font-size:0.82rem">Educational content only: not financial advice. 18+ where applicable. Trade responsibly.</span>
        </div>
        <nav>
          <a href="/about">About</a>
          <a href="/how-we-make-money">How we make money</a>
          <a href="/compare">Compare</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
