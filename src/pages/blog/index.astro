---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
	title="Articles"
	description="Plain-English guides and honest reviews of Kalshi, Polymarket, and Crypto.com prediction markets."
	path="/blog"
>
	<section class="wrap blog-wrap">
		<p class="eyebrow">All articles</p>
		<h1>Guides and platform reviews</h1>
		<p class="lede">Everything you need to understand prediction markets and choose the right platform.</p>

		<div class="post-grid">
			{posts.map((post, i) => (
				<a class={`post-card ${i === 0 ? 'post-card--featured' : ''}`} href={`/blog/${post.id}/`}>
					{post.data.heroImage && (
						<div class="post-img">
							<Image
								src={post.data.heroImage}
								alt={post.data.title}
								width={i === 0 ? 800 : 400}
								height={i === 0 ? 320 : 200}
							/>
						</div>
					)}
					<div class="post-body">
						<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						<h3>{post.data.title}</h3>
						{post.data.description && <p>{post.data.description}</p>}
					</div>
				</a>
			))}
		</div>
	</section>
</Base>

<style>
	.blog-wrap {
		padding-top: 2.5rem;
		padding-bottom: 4rem;
	}

	.post-grid {
		display: grid;
		gap: 1.4rem;
		grid-template-columns: repeat(3, 1fr);
		margin: 2rem 0;
	}

	.post-card--featured {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
	}

	.post-card {
		background: var(--white);
		border: 1px solid var(--rule);
		border-radius: 14px;
		overflow: hidden;
		text-decoration: none;
		color: var(--ink);
		display: flex;
		flex-direction: column;
		transition: transform .15s ease, box-shadow .15s ease;
	}

	.post-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 30px -18px rgba(0,0,0,.4);
		color: var(--ink);
	}

	.post-img {
		overflow: hidden;
	}

	.post-img img {
		width: 100%;
		height: 180px;
		object-fit: cover;
		border-radius: 0;
		display: block;
		transition: transform .3s ease;
	}

	.post-card--featured .post-img img {
		height: 100%;
		min-height: 260px;
	}

	.post-card:hover .post-img img {
		transform: scale(1.03);
	}

	.post-body {
		padding: 1.2rem 1.4rem 1.4rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.post-card--featured .post-body {
		padding: 2rem 2rem 2rem;
		justify-content: center;
	}

	.post-date {
		font-size: 0.78rem;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		letter-spacing: 0.04em;
		margin-bottom: 0.4rem;
		display: block;
	}

	.post-body h3 {
		margin: 0 0 0.4rem;
		font-size: 1rem;
		line-height: 1.3;
	}

	.post-card--featured .post-body h3 {
		font-size: 1.5rem;
	}

	.post-body p {
		font-size: 0.88rem;
		color: var(--ink-soft);
		margin: 0;
		line-height: 1.5;
	}

	.post-card--featured .post-body p {
		font-size: 0.95rem;
	}

	@media (max-width: 900px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.post-card--featured {
			grid-template-columns: 1fr;
		}
		.post-card--featured .post-img img {
			height: 200px;
		}
	}

	@media (max-width: 600px) {
		.post-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
