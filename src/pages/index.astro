---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Find the right prediction market for you</h1>
				<p class="hero-subheadline">
					Plain-English guides and honest comparisons of Kalshi, Polymarket, and Crypto.com — so you can
					pick the right platform and start in minutes.
				</p>
				<a class="button-primary" href="#compare">Compare platforms</a>
			</section>

			<section class="intro">
				<h2>New to prediction markets?</h2>
				<p>
					A prediction market is a marketplace where people trade on the outcome of real-world events —
					elections, sports, economics, and more. Instead of a single expert’s forecast, prices on each
					outcome reflect the crowd’s estimate of how likely it is to happen.
				</p>
				<p>
					If you are new, start with our beginner’s guide for a plain-English walkthrough of how these
					platforms work and what to check before you sign up.
				</p>
				<p>
					<a href="/blog/what-is-a-prediction-market-beginners-guide/">Read the full beginner's guide →</a>
				</p>
			</section>

			<section id="compare" class="compare">
				<h2>Compare the top platforms</h2>
				<div class="platform-grid">
					<article class="platform-card">
						<h3>Kalshi</h3>
						<p><strong>Best for:</strong> US users who want a regulated, mainstream platform.</p>
						<a class="button-secondary" href="/blog/kalshi-review">Read our review →</a>
						<a class="button-platform" href="https://kalshi.com" target="_blank" rel="noopener">Visit Kalshi</a>
					</article>
					<article class="platform-card">
						<h3>Polymarket</h3>
						<p>
							<strong>Best for:</strong> crypto-comfortable users outside the US who want the largest,
							best-known markets.
						</p>
						<a class="button-secondary" href="/blog/polymarket-review">Read our review →</a>
						<a class="button-platform" href="https://polymarket.com" target="_blank" rel="noopener">Visit Polymarket</a>
					</article>
					<article class="platform-card">
						<h3>Crypto.com</h3>
						<p>
							<strong>Best for:</strong> people already in crypto who want prediction markets alongside an
							exchange.
						</p>
						<a class="button-secondary" href="/blog/crypto-com-predict-review">Read our review →</a>
						<a class="button-platform" href="https://crypto.com/predict" target="_blank" rel="noopener">Visit Crypto.com</a>
					</article>
				</div>
				<p class="compare-note">
					Availability and rules vary by country and age — always check before signing up.
				</p>
			</section>

			<p class="affiliate-disclosure">
				We may earn a commission when you sign up through links on this site, at no extra cost to you. This
				keeps our guides free.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 3em;
	}

	.hero-subheadline {
		font-size: 1.15em;
		color: rgb(var(--gray));
		max-width: 42em;
	}

	.button-primary {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.75em 1.5em;
		background: var(--accent);
		color: white;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 700;
	}

	.button-primary:hover {
		background: var(--accent-dark);
		color: white;
	}

	.intro {
		margin-bottom: 3em;
	}

	.intro h2 {
		font-size: 2em;
	}

	.compare h2 {
		font-size: 2em;
	}

	.platform-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25em;
		margin: 1.5em 0 1em;
	}

	.platform-card {
		background: white;
		border-radius: 8px;
		padding: 1.25em;
		box-shadow: var(--box-shadow);
	}

	.platform-card h3 {
		font-size: 1.25em;
		margin-bottom: 0.75em;
	}

	.platform-card p {
		margin-bottom: 0.75em;
		font-size: 0.95em;
	}

	.button-secondary {
		display: block;
		font-size: 0.9em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		margin-bottom: 0.75em;
	}

	.button-secondary:hover {
		color: var(--accent);
	}

	.button-platform {
		display: inline-block;
		padding: 0.6em 1.1em;
		border: 2px solid var(--accent);
		border-radius: 8px;
		color: var(--accent);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95em;
	}

	.button-platform:hover {
		background: var(--accent);
		color: white;
	}

	.compare-note {
		font-size: 0.9em;
		color: rgb(var(--gray));
		margin-bottom: 0;
	}

	.affiliate-disclosure {
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.9em;
		color: rgb(var(--gray));
	}

	@media (max-width: 720px) {
		.platform-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
