---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { platforms, SITE_NAME } from "../config";
const kalshi = platforms.find((p) => p.id === "kalshi")!;
---

<Base
  title="Home"
  description="Predikt explains prediction markets in plain English and helps you choose between Kalshi, Polymarket and Crypto.com — then start trading."
  path="/"
>
  <section class="hero wrap">
    <p class="eyebrow">Prediction markets, made simple</p>
    <h1>Forecast the future. Find the right market.</h1>
    <p class="lede">
      Prediction markets let you trade on what happens next — elections, sports,
      the economy. {SITE_NAME} is the plain-English guide that explains how they
      work and points you to the right platform for you.
    </p>
    <div class="btn-row">
      <a class="btn" href="/what-is-a-prediction-market">Start with the basics</a>
      <a class="btn btn--ghost" href="/compare">Compare platforms</a>
    </div>
  </section>

  <section class="wrap">
    <h2>Where to begin</h2>
    <div class="grid">
      <a class="card" href="/what-is-a-prediction-market">
        <span class="num">01 · Learn</span>
        <h3>What is a prediction market?</h3>
        <p>The 2-minute explainer. What they are, how prices work, and whether they're legit.</p>
      </a>
      <a class="card" href="/compare">
        <span class="num">02 · Compare</span>
        <h3>Kalshi vs Polymarket vs Crypto.com</h3>
        <p>Fees, regions, and what each platform is actually best for — side by side.</p>
      </a>
      <a class="card" href="/guides/how-to-use-kalshi">
        <span class="num">03 · Start</span>
        <h3>How to place your first trade</h3>
        <p>A step-by-step walkthrough, from signing up to your first market.</p>
      </a>
    </div>
  </section>

  <section class="wrap" style="margin: 2.5rem auto 3rem;">
    <h2>Our pick for most beginners</h2>
    <div class="callout">
      <p style="margin:0 0 0.6rem;">
        For US readers new to this, <strong>{kalshi.name}</strong> is the easiest
        regulated place to start — {kalshi.regulation.toLowerCase()}, with a clean
        beginner-friendly interface. Outside the US, see our comparison instead.
      </p>
      <Cta platform={kalshi} />
    </div>
    <p style="font-size:0.85rem; color:var(--ink-soft);">
      Availability and rules differ by country and age. Always check what's legal
      where you live. This is educational content, not financial advice.
    </p>
  </section>
</Base>
