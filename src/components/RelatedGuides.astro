---
/**
 * RelatedGuides — contextual cross-links block.
 *
 * Usage:
 *   import RelatedGuides from '../components/RelatedGuides.astro';
 *   <RelatedGuides slug="kalshi-review" />
 *
 * Pass the page slug (matches keys in src/data/related-links.ts).
 * If no links are defined for the slug, the component renders nothing.
 */
import { relatedLinks } from '../data/related-links';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const links = relatedLinks[slug];
---

{links && links.length > 0 && (
  <aside class="related-guides">
    <h2>Related guides</h2>
    <ul class="related-list">
      {links.map(link => (
        <li>
          <a href={link.href}>
            <span class="related-title">{link.title}</span>
            <span class="related-desc">{link.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related-guides {
    border-top: 1px solid var(--rule, #e5e0d5);
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .related-guides h2 {
    font-size: 1rem;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft, #666);
    margin: 0 0 1rem;
  }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .related-list a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    background: var(--white, #fff);
    border: 1px solid var(--rule, #e5e0d5);
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink, #1a1a1a);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .related-list a:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px -10px rgba(0,0,0,0.2);
    color: var(--ink, #1a1a1a);
  }

  .related-title {
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .related-desc {
    font-size: 0.8rem;
    color: var(--ink-soft, #666);
    line-height: 1.4;
  }
</style>
