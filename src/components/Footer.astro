---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Prediction Markets Guide. All rights reserved.
	<nav class="footer-links" aria-label="Site">
		<a href="/about">About</a>
		<a href="/how-we-make-money">How we make money</a>
		<a href="/blog">Blog</a>
	</nav>
	<p class="disclaimer">
		This site is for educational purposes only and is not financial advice. Prediction markets involve
		risk: only trade what you can afford to lose.
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5em 1.5em;
		margin-top: 1em;
	}
	.footer-links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.footer-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.disclaimer {
		margin-top: 1.5em;
		font-size: 0.85em;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}
</style>
